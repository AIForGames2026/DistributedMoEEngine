// TASK-05: does the datacenter Blackwell Tensor Memory path (tcgen05 / TMEM)
// exist for a target? Assemble with:
//   ptxas -arch=sm_121a tools/probe/tcgen05.ptx -o /dev/null
// sm_100a is the control: it has TMEM, so it must assemble.
.version 9.0
.target sm_121a
.address_size 64

.visible .entry tmem_alloc()
{
    .shared .align 4 .b32 taddr;
    .reg .b32 cols;
    mov.b32 cols, 32;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [taddr], cols;
    tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
    ret;
}
